u(z)&0&1
 \end{pmatrix}.
\end{equation}
Equivalently, the fibrewise $(1,0)$ space is spanned by
\begin{equation}\label{eq:sigmas}
 \sigma_1=6\mu\gamma+\tau u+w,
 \qquad
 \sigma_2=\beta\gamma+\mu u+\delta.
\end{equation}
The fibrewise $(2,0)$ line is generated by
\begin{align}
 \Omega&=\sigma_1\wedge\sigma_2\label{eq:Omega}\notag\\
 &= (6\mu^2-\tau\beta)\gamma u
   -\beta\gamma w
   +6\mu\gamma\delta
   -\mu uw
   +\tau u\delta
   +w\delta.
\end{align}
The scalar
\begin{equation}\label{eq:D}
 D=\im\beta-\frac{6(\im\mu)^2}{\im\tau}
\end{equation}
satisfies
\begin{equation}\label{eq:Dnegative}
 D<0
\end{equation}
throughout the smooth period domain, and
\begin{equation}\label{eq:detPi}
 \det_{\RR}\Pi=\im\tau\,D.
\end{equation}
In particular $D\ne0$ is exactly the real-lattice nondegeneracy condition.

\subsection{A holomorphic volume form on the open threefold}

\begin{proposition}[Distinguished volume form on the smooth locus]\label{prop:openKtrivial}
There is a meromorphic three-form $\Xi_D$ on $X$, unique up to multiplication by a nonzero constant, such that
\begin{equation}\label{eq:Xidivisor}
 \operatorname{div}(\Xi_D)=2S_2-W.
\end{equation}
Its restriction
\begin{equation}\label{eq:Xi}
 \Xi:=\Xi_D|_{X^\circ}
 \end{equation}
is a nowhere-vanishing holomorphic section of $K_{X^\circ}$.
\end{proposition}

\begin{proof}
Alp\"oge proves~\cite[Prop.~9.11]{Alpoge}
\[
 K_X\cong f^*\mathcal O_{\PP^1}(-1)\otimes\mathcal O_X(2S_2).
\]
A fibre represents $f^*\mathcal O_{\PP^1}(1)$, so after choosing the cusp fibre $W$ one has
\[
 K_X\cong\mathcal O_X(2S_2-W).
\]
The divisor line bundle $\mathcal O_X(2S_2-W)$ has its canonical meromorphic section with divisor $2S_2-W$.  Transporting that section through the displayed isomorphism gives $\Xi_D$.  Any two such transports differ by a nowhere-vanishing holomorphic function on compact connected $X$, hence by a nonzero constant.  Removing $W,S_1,S_2$ removes the zero and pole divisor, so the restriction is holomorphic and nowhere zero.
\end{proof}
This projective normalization is stronger than mere triviality of $K_{X^\circ}$.  Scaling $\Xi$ by $c\in\CC^*$ leaves its divisor fixed and changes only one positive scale $|c|^2$ in the base factor of the metric below.

The form $\Xi$ determines a holomorphic one-form on the base with values in the flat local system $\cW_\CC=R^2 f^\circ_*\CC$.  Intrinsically, for $v\in T_bB^\circ$, lift $v$ to $X^\circ$ and set
\begin{equation}\label{eq:alpha-intrinsic}
 \alpha(v)=\left[\iota_{\widetilde v}\Xi\big|_{X_b}\right]\in H^2(X_b,\CC).
\end{equation}
This is independent of the lift because $\Xi$ vanishes on three vertical vectors.  In a flat marking and local coordinate $z$,
\begin{equation}\label{eq:alpha-local}
 \alpha=A(z)\,\dd z,
 \qquad
 A(z)=a(z)\Omega(z)
\end{equation}
for a nowhere-zero holomorphic scalar $a(z)$.  The Gauss--Manin covariant exterior derivative vanishes, $\dd_{\nabla^{\rm GM}}\alpha=0$: locally this is simply
\[
 \dd(A(z)\dd z)=A'(z)\dd z\wedge\dd z=0.
\]

\section{The decisive wedge identities}\label{sec:wedge}

